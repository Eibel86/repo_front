<div class="container my-5">
  <div class="row justify-content-center">

    <% if (films && films.length > 0) { %>
      <% films.forEach(film => { %>
        <%- include("../partials/card", { film }) %>
      <% }) %>
    <% } else { %>
      <div class="col-12 text-center">
        <div class="alert alert-info">No se encontraron películas.</div>
      </div>
    <% } %>
  </div>
</div>

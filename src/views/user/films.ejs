<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title> First front</title>
</head>

<%- include("../partials/header") -%>

    <h1>Películas</h1>

    <form action="/films/searchFilmsByTitle" method="POST">
        <input type="text" name="title">
        <input type="submit" value="Buscar">
    </form>

    <% if (films && films.length> 0) { %>
        <% films.forEach(film=> { %>
            <%- include("../partials/card", { film }) %>
                <% }) %>
                    <% } else { %>
                        <p>No se encontraron películas.</p>
                        <% } %>

                            <%- include("../partials/footer") -%>
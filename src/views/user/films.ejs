<%- include('../templates/header', { title: 'Películas | MovieApp' }) %>

    <div class="forms-page">
        <div class="form-card">
            <!-- Título de página -->
            <h2 class="text-center mb-4">Películas</h2>

            <!-- Buscador (formato “pill”) -->
            <form action="/films/searchFilmsByTitle" method="POST" class="d-flex mb-4" novalidate>
                <input type="text" name="title" class="form-control form-control-pill me-2"
                    placeholder="Buscar por título" required />
                <button type="submit" class="btn btn-primary btn-pill">
                    Buscar
                </button>
            </form>

            <!-- Grilla responsive de tarjetas -->
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                <% if (films && films.length> 0) { %>
                    <% films.forEach(film=> { %>
                        <div class="col">
                            <%- include('../partials/card', { film, backendUrl, favouritesFilmId, showFavouriteButton,
                                showEditButton, showDeleteButton }) %>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <p class="text-center">No se encontraron películas.</p>
                                <% } %>
            </div>
        </div>
    </div>

    <%- include('../templates/footer') %>
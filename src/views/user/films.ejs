<%- include("../templates/header_user") -%>

<header class="bg-primary py-4 mb-4">
  <div class="container">
    <h1 class="text-white text-center">Películas</h1>
  </div>
</header>

<main class="container">

  <!-- Formulario de búsqueda -->
  <form action="/films/searchFilmsByTitle" method="POST" class="row g-3 justify-content-center mb-4">
    <div class="col-md-6">
      <input type="text" name="title" class="form-control form-control-pill" placeholder="Buscar por título" />
    </div>
    <div class="col-auto">
      <input type="submit" value="Buscar" class="btn btn-primary btn-pill px-4" />
    </div>
  </form>

  <!-- Contenedor de tarjetas de películas -->
  <section>
    <%- include("../partials/cardContainer") %>
  </section>

</main>

<%- include("../templates/footer") -%>
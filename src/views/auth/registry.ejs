<!DOCTYPE html> 
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MovieApp - Sign Up</title>
    <!-- Bootstrap e iconos CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/main.css" />
</head>



<body class="d-flex flex-column" style="height: 100vh; background-color: black; color: white;">
    <!-- Header: navegación superior -->
    <header class="forms-nav btn-group">
        <a href="/login" class="btn btn-light btn-pill">Log in</a>
        <a href="/registry" class="btn btn-light btn-pill active">Sign up</a>
    </header>

    <!-- Contenedor principal que ocupa espacio disponible -->
    <section class="containerLogin flex-grow-1 d-flex justify-content-center align-items-center">
        <div class="form-card bg-secondary bg-opacity-25 p-4 rounded">
            <h2 class="mb-4 text-white">MovieApp</h2>
            <form method="POST" action="/registry" novalidate>
                <div class="mb-3">
                    <input type="text" name="name" class="form-control form-control-pill" placeholder="Name" required />
                </div>
                <div class="mb-3">
                    <input type="email" name="email" class="form-control form-control-pill" placeholder="Email" required />
                </div>
                <div class="mb-3">
                    <input type="password" name="password" class="form-control form-control-pill" placeholder="Contraseña" required />
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-pill">Sign Up</button>
                </div>
            </form>
        </div>
    </section>

    <!-- Footer fijo abajo -->
    <footer class="loginFooter">
        <p class="mb-0">&copy; 2025 MovieApp Team</p>
        </button>
    </footer>
</body>
</html>
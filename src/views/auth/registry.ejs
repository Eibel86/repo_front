<%- include("../templates/header", { title: 'Sign up | MovieApp' }) %>

    <div class="forms-page d-flex justify-content-center align-items-center">
        <!-- Nav pills -->
        <div class="forms-nav btn-group">
            <a href="/login" class="btn btn-light btn-pill">Log in</a>
            <a href="/register" class="btn btn-light btn-pill active">Sign up</a>
        </div>

        <!-- Card del formulario -->
        <div class="form-card text-center">
            <h2 class="mb-4">MovieApp</h2>
            <form method="POST" action="/registry" novalidate>
                <div class="mb-3">
                    <input type="text" name="name" class="form-control form-control-pill" placeholder="Name" required>
                </div>
                <div class="mb-3">
                    <input type="email" name="email" class="form-control form-control-pill" placeholder="Email"
                        required>
                </div>
                <div class="mb-3">
                    <input type="password" name="password" class="form-control form-control-pill"
                        placeholder="Contraseña" required>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-pill">
                        Sign Up
                    </button>
                </div>
            </form>
        </div>
    </div>

    <%- include("../templates/footer") %>
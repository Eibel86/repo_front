<%- include("../templates/header", { title: 'Login | MovieApp' }) %>

    <div class="forms-page d-flex flex-column flex-md-row justify-content-center align-items-center">
        <!-- Nav pills arriba en móvil, absolute en desktop -->
        <div class="forms-nav btn-group">
            <a href="/login" class="btn btn-light btn-pill <%= active==='login'?'active':'' %>">Log in</a>
            <a href="/registry" class="btn btn-light btn-pill <%= active==='registry'?'active':'' %>">Sign up</a>
        </div>

        <!-- Aquí va tu .form-card tal cual -->
        <div class="form-card text-center">
            <h2 class="mb-4">MovieApp</h2>
            <form method="POST" action="/login" novalidate>
                <div class="mb-3">
                    <input type="email" name="email" class="form-control form-control-pill" placeholder="Email"
                        required>
                </div>
                <div class="mb-3">
                    <input type="password" name="password" class="form-control form-control-pill"
                        placeholder="Contraseña" required>
                </div>
                <div class="d-grid mb-2">
                    <button type="submit" class="btn btn-primary btn-pill">
                        Log in
                    </button>
                </div>
            </form>
        </div>
    </div>

    <%- include("../templates/footer") %>
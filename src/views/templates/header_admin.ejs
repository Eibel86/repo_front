<!-- Bootstrap CSS (CDN) -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <!-- Bootstrap y boostrap icons CDN -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  
  <link rel="stylesheet" href="/css/main.css">
</head>



<header class="bg-secondary bg-opacity-50 text-white px-4 py-2 d-flex justify-content-between align-items-center">
  <h1 class="h4 mb-0 fw-bold">MovieApp</h1>

  <!-- Botón hamburguesa mobile -->
  <button class="btn menu-toggle d-md-none" onclick="toggleMenu()">
    <i class="bi bi-list fs-1"></i> <!-- icono grande -->
  </button>

  <!-- Menú desktop -->
  <nav class="desktop-nav d-none">
    <ul class="nav">
      <li class="nav-item"><a class="nav-link text-white fw-bold" href="/films">Colección de películas</a></li>
      <li class="nav-item"><a class="nav-link text-white fw-bold" href="/logout">Cerrar Sesión</a></li>
    </ul>
  </nav>
</header>

<!-- Menú lateral mobile -->
<div class="side-menu p-4 d-md-none" id="mobileMenu">
  <button class="btn mb-4" onclick="toggleMenu()">
    <strong>&times;</strong>
  </button>
  <ul class="list-unstyled fs-4 fw-bold">
    <li><a class="text-dark text-decoration-none d-block mb-3" href="/films">Colección</a></li>
    <li><a class="text-dark text-decoration-none d-block mb-3" href="/logout">Cerrar Sesión</a></li>
  </ul>
</div>
<div class="menu-overlay" id="menuOverlay" onclick="toggleMenu()"></div>

<!-- Bootstrap JS + Toggle Script -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  function toggleMenu() {
    const menu = document.getElementById('mobileMenu');
    const overlay = document.getElementById('menuOverlay');
    menu.classList.toggle('open');
    overlay.classList.toggle('show');
  }
</script>


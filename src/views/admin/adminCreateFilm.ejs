<%- include('../templates/header_admin', { title: 'Crear película | MovieApp' }) %>

    <div class="forms-page d-flex justify-content-center align-items-center mt-5 mb-5">
        <div class="form-card text-center">
            <h2 class="mb-4">Crear una película</h2>
            <form action="createfilm" method="POST" enctype="multipart/form-data" novalidate>
                <!-- Título -->
                <div class="mb-3 text-start">
                    <label for="full_title" class="form-label">Título</label>
                    <input type="text" name="full_title" id="full_title" class="form-control form-control-pill"
                        placeholder="Introduce el título" required>
                </div>

                <!-- Director -->
                <div class="mb-3 text-start">
                    <label for="director_name">Director</label>
                    <input type="text" name="director_name" id="director_name" class="form-control form-control-pill"
                        placeholder="Introduce el nombre del director" required>
                </div>

                <!-- Imagen -->
                <div class="mb-3 text-start">
                    <label for="poster" class="form-label">Cartel</label>
                    <input type="file" name="poster" id="poster" class="form-control form-control-pill" required>
                </div>

                <!-- Release_data -->
                <div class="mb-3 text-start">
                    <label for="release_date">Fecha de estreno</label>
                    <input type="date" name="release_date" id="release_date" class="form-control form-control-pill"
                        placeholder="Introduce la fecha de estreno" required>
                </div>

                <!-- Duration -->
                <div class="mb-3 text-start">
                    <label for="duration">Duración (minutos)</label>
                    <input type="number" name="duration" id="duration" class="form-control form-control-pill"
                        placeholder="Duración" required>
                </div>

                <!-- Sinopsis -->
                <div class="mb-3 text-start">
                    <label for="synopsis" class="form-label">Sinopsis</label>
                    <textarea name="synopsis" id="synopsis" rows="5" class="form-control"
                        placeholder="Escribe la sinopsis" required></textarea>
                </div>

                <!-- Botón -->
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-pill">
                        Crear película
                    </button>
                </div>
            </form>
        </div>
    </div>

<%- include('../templates/footer') %>
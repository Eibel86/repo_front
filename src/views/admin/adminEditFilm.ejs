<%- include('../templates/header') %>

    <header>
        <h1>Editar pelicula</h1>
    </header>

    <main>
        <!-- FORMULARIO: CREATE FILM ----------------------------------------------->
        <form action="editFilmProxy" method="POST" enctype="multipart/form-data" novalidate>
            <!--Para enviar imgs Multer-->
            <div>
                <input type="hidden" name="film_id" id="film_id" value="<%= film.film_id %>" required />
            </div>

            <%# INPUT: full_title %>
                <div>
                    <label for="full_title">Título</label>
                    <input type="text" name="full_title" id="full_title" value="<%= film.full_title %>" required />
                </div>

                <%# INPUT: director_name %>
                    <div>
                        <label for="director_name">Director</label>
                        <input type="text" name="director_name" id="director_name" value="<%= film.director_name %>"
                            required />
                        <!-- value = ejs obtener valor-->
                    </div>

                    <%# INPUT: genre_name %>
                        <div>
                            <label for="genre_name">Género</label>
                            <input type="text" name="genre_name" id="genre_name" value="<%= film.genre_name %>"
                                required />
                        </div>

                        <%# INPUT: image (input type file)%>
                            <div>
                                <label for="image">Imagen de la película</label>
                                <input type="file" name="image" id="image" accept="image/*" />
                            </div>

                            <%# INPUT: release_date %>
                                <div>
                                    <label for="release_date">Fecha de estreno</label>
                                    <% const formattedDate=new Date(film.release_date).toISOString().split('T')[0]; %>
                                        <input type="date" name="release_date" id="release_date"
                                            value="<%= formattedDate %>" required />
                                </div>

                                <%# INPUT: duration %>
                                    <div>
                                        <label for="duration">Duración (minutos)</label>
                                        <input type="number" name="duration" id="duration" value="<%= film.duration %>"
                                            required />
                                    </div>

                                    <%# INPUT: synopsis %>
                                        <div>
                                            <label for="synopsis">Sinopsis</label>
                                            <textarea name="synopsis" id="synopsis" rows="5"
                                                required> <%= film.synopsis %></textarea>
                                        </div>

                                        <%# INPUT: botón de enviar %>
                                            <div>
                                                <button type="submit">Guardar cambios</button>
                                            </div>
        </form>
    </main>

    <%- include('../templates/footer') %>
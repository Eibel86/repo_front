<%- include('../templates/header', { title: 'Editar película | MovieApp' }) %>

    <div class="forms-page d-flex justify-content-center align-items-center">
        <div class="form-card text-center">
            <h2 class="mb-4">Editar película</h2>
            <form action="editFilmProxy" method="POST" enctype="multipart/form-data" novalidate>
                <!-- ID Oculto -->
                <input type="hidden" name="film_id" value="<%= film.film_id %>">

                <!-- Título -->
                <div class="mb-3 text-start">
                    <label for="full_title" class="form-label">Título</label>
                    <input type="text" name="full_title" id="full_title" class="form-control form-control-pill"
                        value="<%= film.full_title %>" required>
                </div>

                <!-- Director_name -->
                <div class="mb-3 text-start">
                    <label for="director_name" class="form-label">Director</label>
                    <input type="text" name="director_name" id="director_name" class="form-control form-control-pill"
                        value="<%= film.director_name %>" required>
                </div>

                <!-- Genre_name -->
                <div class="mb-3 text-start">
                    <label for="genre_name" class="form-label">Género</label>
                    <input type="text" name="genre_name" id="genre_name" class="form-control form-control-pill"
                        value="<%= film.genre_name %>" required>
                </div>

                <!-- Cartel -->
                <div class="mb-3 text-start">
                    <label for="poster" class="form-label">Cartel</label>
                    <input type="file" name="poster" id="poster" class="form-control form-control-pill">
                </div>

                <!-- Realease_date -->
                <div class="mb-3 text-start">
                    <label for="release_date" class="form-label">Fecha de estreno</label>
                    <% const formattedDate=new Date(film.release_date).toISOString().split('T')[0]; %>
                        <input type="date" name="release_date" id="release_date" class="form-control form-control-pill"
                            value="<%= formattedDate %>" required>
                </div>

                <!-- Duration -->
                <div class="mb-3 text-start">
                    <label for="duration">Duración (minutos)</label>
                    <input type="number" name="duration" id="duration" class="form-control form-control-pill"
                        value="<%= film.duration %>" required>
                </div>

                <!-- Sinopsis -->
                <div class="mb-3 text-start">
                    <label for="synopsis" class="form-label">Sinopsis</label>
                    <textarea name="synopsis" id="synopsis" rows="5" class="form-control form-control-pill"
                        required><%= film.synopsis %></textarea>
                </div>

                <!-- Botón -->
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-pill">
                        Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>

    <%- include('../templates/footer') %>